# ===== Провайдер LLM для сценариев/анализа/перевода =====
# "claude" (платный, по умолчанию) или "gemini" (есть бесплатный лимит — ключ
# на aistudio.google.com/apikey). При gemini ниже достаточно заполнить
# GEMINI_API_KEY, секция Claude не нужна.
LLM_PROVIDER=claude

# ===== Claude API =====
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# ===== Gemini API (используется, если LLM_PROVIDER=gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FAST=gemini-2.0-flash

# ===== YouTube Data API v3 (анализ ниш) =====
# Бесплатная квота 10 000 units/день. Ключ: console.cloud.google.com ->
# APIs & Services -> Credentials (включите "YouTube Data API v3").
# ВНИМАНИЕ: один поиск (search.list) = 100 units, скан на 8 под-ниш ~800 units.
YOUTUBE_API_KEY=
YOUTUBE_REGION=US
YOUTUBE_LANGUAGE=ru

# ===== Pexels (стоковое видео) =====
PEXELS_API_KEY=

# ===== Replicate (опционально — AI-визуальный ряд) =====
# Ключ: replicate.com/account/api-tokens. Без него рендер использует
# простую статичную обложку (fallback), визуальный ряд просто не генерируется.
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# Картинка меняется каждые N минут видео
VISUAL_SEGMENT_MINUTES=3
# Потолок числа картинок за видео (защита от случайного перерасхода)
VISUAL_MAX_IMAGES=12
# Генерировать каждую картинку с опорой на первую (img2img) — сильнее держит
# единый стиль/композицию. Требует модель с поддержкой входного image
# (flux-dev), на flux-schnell автоматически откатывается на text-only.
VISUAL_USE_REFERENCE=false
VISUAL_REFERENCE_STRENGTH=0.85
# Апскейл картинок после генерации (Real-ESRGAN, ~$0.002-0.004/шт) — поднимает
# типичный выход FLUX (~1MP) до Full HD+. Отключить: VISUAL_UPSCALE=false
VISUAL_UPSCALE=true
REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan
VISUAL_UPSCALE_FACTOR=2

# ===== Пути =====
DATA_DIR=./data
DB_PATH=./data/db.sqlite

# ===== Kokoro TTS =====
KOKORO_MODEL_PATH=
KOKORO_DEVICE=cuda

# ===== FFmpeg =====
FFMPEG_PATH=ffmpeg

# ===== Сервер =====
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
